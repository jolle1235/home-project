#!/bin/sh
# Generated by fallow hooks install --target git.
# fallow pre-commit hook -- gate commits on dead code, complexity, and duplication.
# Config lives in .fallowrc.jsonc: audit.gate = "all" fails on every dead-code or
# duplication finding in changed files; complexity is compared against
# .fallow-health-baseline.json, so only newly introduced complexity fails.
# Installed via `npm install` (the "prepare" script sets core.hooksPath=.githooks).
# Do not bypass with --no-verify; fix the findings instead (see .claude/skills/commit).

if command -v fallow >/dev/null 2>&1; then FALLOW="fallow"
elif [ -x node_modules/.bin/fallow ]; then FALLOW="node_modules/.bin/fallow"
else echo "fallow not installed (run npm ci)"; exit 1; fi
UPSTREAM="$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
if [ -n "$UPSTREAM" ]; then
  # Diff against the merge-base with the upstream so feature branches forked off
  # a non-default integration branch (next-release / hotfix / LTS) compare
  # against the right base, not against their own remote tracking branch.
  BASE="$(git merge-base "$UPSTREAM" HEAD 2>/dev/null || echo "$UPSTREAM")"
else
  BASE="master"
fi
$FALLOW audit --base "$BASE" --quiet --gate-marker pre-commit
